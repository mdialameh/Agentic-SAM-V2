# Copy to .env and fill in. Never commit .env.
# Local vLLM (default) needs no key. For OpenAI cloud: set the key and
# ASAM_LLM_BASE_URL= (empty) and e.g. ASAM_LLM_MODEL=gpt-5.4-nano
# OPENAI_API_KEY=
# HF_TOKEN=            # needed by downloader.py for the gated facebook/sam3.1 repo
# ASAM_GPU=0
# ASAM_LLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# ASAM_PIXEL_SPACING_MM=0
